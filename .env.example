DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-reasoner
BERT_THRESHOLD=0.6
DATABASE_URL=sqlite:///data/logsentinel.db
LLM_ONLY_SOURCES=LegacyCRM
LLM_CATEGORIES=Workflow Error,Deprecation Warning
MAX_WORKERS=4

# --- security / ops ---
AUTH_ENABLED=true
API_KEYS=change-me-dev-key        # comma-separated, generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
RATE_LIMIT_PER_MIN=120
MAX_CSV_BYTES=10000000
LOG_JSON=true
DASHBOARD_API_KEY=change-me-dev-key   # key the dashboard container uses (must be one of API_KEYS)
